# ---- Database (Supabase: Project Settings > Database > Connection string, "Session pooler" URI) ----
# Leave unset for local dev to use a SQLite file.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ---- Security (generate long random values: python -c "import secrets;print(secrets.token_urlsafe(32))") ----
ADMIN_PASSWORD=choose-a-strong-password
SECRET_KEY=long-random-string
CRON_SECRET=another-long-random-string

# Comma-separated list of allowed website origins (your Vercel URL / custom domain)
CORS_ORIGINS=https://your-site.vercel.app,http://localhost:3000
TIMEZONE=Africa/Lagos

# ---- WhatsApp Cloud API ----
# Leave WHATSAPP_TOKEN empty to stay in MOCK mode (messages are only saved to the admin "WhatsApp log").
WHATSAPP_MODE=auto            # auto | mock | live
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-string-and-paste-it-in-meta-dashboard
WHATSAPP_APP_SECRET=          # Meta app secret: enables webhook signature checking (recommended)
OWNER_WHATSAPP=2348061380762  # who gets new-lead alerts (digits only, with country code)

# Template names exactly as approved in Meta (see docs/whatsapp-templates.md)
TPL_REMINDER=clean_reminder
TPL_OWNER_ALERT=new_lead_alert
TPL_LANGUAGE=en
